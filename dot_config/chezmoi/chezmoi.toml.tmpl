# Global chezmoi configuration with convenient template data
{{- $profile := default "desktop" (index . "bootstrap_profile") -}}

[data]
  bootstrap_profile = "{{ $profile }}"

  [data.machine]
    os = {{ quote .chezmoi.os }}
    arch = {{ quote .chezmoi.arch }}
    hostname = {{ quote .chezmoi.hostname }}
    username = {{ quote .chezmoi.username }}
  [data.paths]
    home = {{ quote .chezmoi.homeDir }}
    btop_theme = {{ quote (joinPath .chezmoi.homeDir ".config/btop/themes/dracula.theme") }}

[git]
  autoCommit = false
  autoPush = false

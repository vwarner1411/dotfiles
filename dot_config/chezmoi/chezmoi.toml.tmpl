# Global chezmoi configuration with convenient template data
{{- $profile := "desktop" -}}
{{- $configPath := joinPath .chezmoi.homeDir ".config/chezmoi/chezmoi.toml" -}}
{{- if fileExists $configPath -}}
  {{- $existing := include $configPath | fromToml -}}
  {{- with $existing.data.bootstrap_profile -}}
    {{- $profile = . -}}
  {{- end -}}
{{- end -}}
{{- with .bootstrap_profile -}}
  {{- $profile = . -}}
{{- end -}}

[data]
  bootstrap_profile = "{{ $profile }}"

  [data.machine]
    os = {{ quote .chezmoi.os }}
    arch = {{ quote .chezmoi.arch }}
    hostname = {{ quote .chezmoi.hostname }}
    username = {{ quote .chezmoi.username }}
  [data.paths]
    home = {{ quote .chezmoi.homeDir }}
    btop_theme = {{ quote (joinPath .chezmoi.homeDir ".config/btop/themes/dracula.theme") }}

[git]
  autoCommit = false
  autoPush = false

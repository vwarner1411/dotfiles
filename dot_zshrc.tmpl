

# History size
export HISTSIZE=10000
export HISTFILESIZE=10000

# Normalize PATH so repeated entries collapse
typeset -U PATH path

# Oh-My-Zsh base
export ZSH="$HOME/.oh-my-zsh"
FPATH=$ZSH/custom/plugins/zsh-completions/src:$FPATH

ZSH_THEME="dracula-pro"   # falls back to "dracula" automatically
plugins=(git autoupdate zsh-syntax-highlighting zsh-autosuggestions \
         zsh-completions jsontools)
source $ZSH/oh-my-zsh.sh

# Aliases
alias vi='/usr/bin/nvim -u ~/.nvimrc'
alias vim='/usr/bin/nvim -u ~/.nvimrc'
alias nvim='/usr/bin/nvim -u ~/.nvimrc'
alias l='lsd -l'
alias ll='lsd -la'
alias ls='lsd'
# Additional OS-specific aliases
alias python="python3"
alias pip="pip3"
alias powershell="pwsh"
alias aptski="sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y"
alias mosh="mosh -a"
alias youtube-dl-1080="yt-dlp -c -f 137+140 -o '%(title)s.%(ext)s' --external-downloader aria2c --downloader-args 'aria2c:-c -j 16 -x 16 -s 16 -k 5M'"
alias youtube-dl="yt-dlp -c -S res,ext:mp4:m4a -o '%(title)s.%(ext)s' --external-downloader aria2c --downloader-args 'aria2c:-c -j 16 -x 16 -s 16 -k 5M'"

# Session behaviour tweaks
setopt extended_glob \
       hist_ignore_dups \
       hist_reduce_blanks \
       share_history \
       inc_append_history

# Handy builtins
autoload -Uz zmv

# Prompt and interactive helpers
eval "$(starship init zsh)"
source <(fzf --zsh)
# Load OS-specific snippets
if [[ -f "/home/warnerva/.zshrc.d/linux.zsh" ]]; then
  source "/home/warnerva/.zshrc.d/linux.zsh"
fi

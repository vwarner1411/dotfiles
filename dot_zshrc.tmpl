{{- $osDataPath := joinPath .chezmoi.sourceDir (printf "dot_config/chezmoi/data/os/%s.toml" .chezmoi.os) -}}
{{- $osData := (include $osDataPath | fromToml) -}}
{{- $profile := default "desktop" (index . "bootstrap_profile") -}}
{{- $serverAliasSkip := dict "powershell" true "mosh" true "youtube-dl" true "youtube-dl-1080" true -}}
{{- $nvim := "nvim" -}}
{{- with $osData.nvim }}
  {{- with .bin }}
    {{- $nvim = . -}}
  {{- end }}
{{- end }}
{{- $extraZsh := list -}}
{{- with $osData.zsh }}
  {{- with .extra }}
    {{- $extraZsh = . -}}
  {{- end }}
{{- end }}
{{- $aliasList := list -}}
{{- with $osData.zsh }}
  {{- with .aliases }}
    {{- $aliasList = . -}}
  {{- end }}
{{- end }}
{{- /* prevent leading blank line */ -}}

# History size
export HISTSIZE=10000
export HISTFILESIZE=10000

# Normalize PATH so repeated entries collapse
typeset -U PATH path

# Oh-My-Zsh base
export ZSH="$HOME/.oh-my-zsh"
if [[ -d $ZSH/custom/plugins/zsh-completions/src ]]; then
  FPATH=$ZSH/custom/plugins/zsh-completions/src:$FPATH
fi

ZSH_THEME=""
plugins=(git autoupdate zsh-syntax-highlighting zsh-autosuggestions \
         zsh-completions)
if [[ -f $ZSH/oh-my-zsh.sh ]]; then
  source $ZSH/oh-my-zsh.sh
fi

if command -v {{ $nvim }} >/dev/null 2>&1; then
  alias vi='{{ $nvim }} -u ~/.nvimrc'
  alias vim='{{ $nvim }} -u ~/.nvimrc'
  alias nvim='{{ $nvim }} -u ~/.nvimrc'
fi

if command -v lsd >/dev/null 2>&1; then
  alias l='lsd -l'
  alias ll='lsd -la'
  alias ls='lsd'
  alias la='lsd -la'
  alias lsa='lsd -la'
  alias lt='lsd --tree --depth 2'
  alias lta='lsd --tree --depth 2 -a'
fi
{{- if gt (len $aliasList) 0 }}
# Additional OS-specific aliases…
{{- range $alias := $aliasList }}
  {{- if not (and (eq $profile "server") (index $serverAliasSkip $alias.name)) }}
alias {{ $alias.name }}="{{ $alias.command }}"
  {{- end }}
{{- end }}
{{- end }}

# Session behaviour tweaks
setopt extended_glob \
       hist_ignore_dups \
       hist_reduce_blanks \
       share_history \
       inc_append_history

# Handy builtins
autoload -Uz zmv

if command -v apt >/dev/null 2>&1; then
  alias aptski='sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y'
fi

if command -v pacman >/dev/null 2>&1; then
  if command -v omarchy-update >/dev/null 2>&1; then
    alias archski='omarchy-update'
  elif command -v yay >/dev/null 2>&1; then
    alias archski='yay -Syu'
  else
    alias archski='sudo pacman -Syu'
  fi
fi

if command -v brew >/dev/null 2>&1; then
  alias brewski='brew update && brew upgrade && brew cleanup -s && brew doctor && brew missing'
fi

if command -v tealdeer >/dev/null 2>&1; then
  alias tldr='tealdeer'
elif command -v tldr >/dev/null 2>&1; then
  alias tealdeer='tldr'
fi

if command -v yazi >/dev/null 2>&1; then
  alias yz='yazi'
fi

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

if command -v starship >/dev/null 2>&1; then
{{- if ne $profile "server" }}
  eval "$(starship init zsh)"
{{- else }}
  # starship disabled on server profile
{{- end }}
fi

{{- if gt (len $extraZsh) 0 }}
# Load OS-specific snippets
{{- range $path := $extraZsh }}
if [[ -f {{ quote (joinPath $.chezmoi.homeDir $path) }} ]]; then
  source {{ quote (joinPath $.chezmoi.homeDir $path) }}
fi
{{- end }}
{{- end }}
